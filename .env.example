# Server-side variables. Connect Upstash Redis through Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
# The default namespace is VERCEL_ENV (production/preview/development).
# AGENTMODS_STATS_NAMESPACE=production
# Local Node hosting can keep SQLite instead:
# AGENTMODS_STATS_DB=/var/data/prompt-copies.sqlite
