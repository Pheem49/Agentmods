{
  "name": "agentmods",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "start": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run validate:mods && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:mods": "node --experimental-strip-types scripts/validate-mods.mjs"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "lucide-react": "1.28.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vite": "8.0.16",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "6.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
